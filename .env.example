# Jhinuk AI Router — environment variables (PLACEHOLDERS ONLY, never real secrets)
# Copy to .env and fill in. Never commit .env.

# --- Database (required for full operation; /health works without it) ---
DATABASE_URL=postgresql://router:CHANGE_ME@localhost:5432/jhinuk_router?schema=public

# --- Redis (OPTIONAL — router runs without it; in-memory fallback is used) ---
REDIS_URL=

# --- Server ---
PORT=3001
WEB_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- Secrets (generate with: openssl rand -hex 32) ---
SESSION_SECRET=CHANGE_ME_64_hex_chars
JWT_SECRET=CHANGE_ME_64_hex_chars
# 64 hex chars = 32 bytes, AES-256-GCM master key for provider credentials
ENCRYPTION_MASTER_KEY=CHANGE_ME_64_hex_chars
ROUTER_MASTER_KEY=CHANGE_ME_router_master_key

# --- Registration ---
REGISTRATION_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false
